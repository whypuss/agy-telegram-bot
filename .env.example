# =============================================================================
# Antigravity Telegram Bot — 環境設定範本 (.env.example)
# =============================================================================

# 1. Telegram Bot Token（必填，請在 Telegram 搜尋 @BotFather 建立機器人取得）
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 2. 授權使用者 User ID（強烈建議填寫，多個 ID 請用逗號分隔）
# 在 Telegram 搜尋你建立的 Bot 發送 /start 即可獲取你的 User ID
ALLOWED_USER_IDS=1120349178

# 3. 網路代理 Proxy（選填，若在大陸地區或無法直連 Telegram API 時填寫）
# 例如: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
PROXY_URL=

# 4. Antigravity CLI 路徑與設定（選填，預設會自動尋找 PATH 中的 agy）
AGY_PATH=agy

# 預設 AI 模型（支援 Gemini 3.8 Flash (Medium)、Gemini 3.8 Flash (High)、Claude Opus 4.6 (Thinking) 等）
AGY_MODEL=Gemini 3.8 Flash (Medium)

# 單次任務執行超時時間（秒，預設 3600 秒 / 1 小時）
AGY_TIMEOUT=3600

# 4b. 本地 OpenCode 自動備援（選填）
# ENABLE_OPENCODE_FALLBACK: true 時，Antigravity 失敗/超時/空回覆會自動用本地 opencode 重試一次
# OPENCODE_PATH: opencode 可執行檔路徑（留空自動尋找，含 Homebrew Cellar 實體二進位）
# OPENCODE_MODEL: 備援與預設 OC 模型（必須可用，勿用需外部 proxy 的 cliproxy 模型）
# OPENCODE_TIMEOUT: 單次 opencode 執行超時（秒，預設 600）
ENABLE_OPENCODE_FALLBACK=true
OPENCODE_PATH=
OPENCODE_MODEL=sensenova/deepseek-v4-flash
OPENCODE_TIMEOUT=600

# 5. 工作目錄 Workspace Directory（選填，預設為當前使用者主目錄）
# Agent 會在此目錄讀寫檔案與執行指令
WORKSPACE_DIR=/Users/my

# 6. 群組標註策略（選填，預設 true）
# true: 群組內需要 @bot 或回覆機器人訊息才會響應；false: 群組內所有訊息皆響應
REQUIRE_MENTION_IN_GROUPS=true

# 7. 訊息與媒體防抖設定（選填，秒）
# TEXT_BATCH_DELAY_SECONDS: 聚合 Telegram 客戶端長文字自動分段的延遲
# MEDIA_BATCH_DELAY_SECONDS: 聚合 Telegram 相簿多圖發送的延遲
TEXT_BATCH_DELAY_SECONDS=0.6
MEDIA_BATCH_DELAY_SECONDS=0.8

# 8. 多模態暫存目錄（選填）
# CACHE_DIR=/Users/my/.gemini/tg_media_cache

# 9. 自我進化：Policy 管理員白名單（選填；目前冇 Telegram 指令用到）
# /pin 同 /unpin 已移除,呢個變數保留畀日後可能重新引入嘅管理操作。
# 唔會繼承 ALLOWED_USER_IDS;未設定、留空、或格式錯誤一律解析成空集合。
# 一個無效項目會令整個值作廢,唔會留低「部分有效」嘅白名單。
POLICY_ADMIN_IDS=

# 10. Agent 操作守則注入（選填）
# agy 只有喺傳 --add-dir 時先會讀 AGENTS.md，而嗰個 flag 會連帶載入
# .agents/skills/ 全部描述（實測 +4,808 tokens，每個 tool round 重覆計）。
# 改為指向一個 markdown 檔，內容會注入對話第一轉（實測約 357 tokens）。
# 檔案讀唔到會喺 stderr 大聲報錯，唔會靜靜地當冇守則。
AGENT_PROTOCOL_FILE=

# AGENT_SYSTEM_PROMPT: 單行守則，會同 AGENT_PROTOCOL_FILE 內容合併
AGENT_SYSTEM_PROMPT=

# 11. 是否傳 --add-dir 畀 agy（選填，預設 0）
# 0 = 唔傳。Agent 仍然以 WORKSPACE_DIR 作 cwd，讀寫該目錄不受影響，
#     但唔會預載 skills 描述同 AGENTS.md。一句 "hi" 由 19,333 降到 13,048 tokens。
# 1 = 還原舊行為（需要 agy 自動載入 AGENTS.md / .agents/skills 時先開）。
AGY_ADD_WORKSPACE_DIR=0
